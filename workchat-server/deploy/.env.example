# workchat-server settings. Save this file as `.env` next to docker-compose.yml. Never commit .env.
# Every line is optional: delete what you do not need. Names are WORKCHAT_*.

# --- Address ------------------------------------------------------------------------------------------------------
# The public address clients use, with the scheme (goes into one-time login links). Examples:
#   https://chat.example.com        (behind your tunnel or reverse proxy)
#   http://192.168.1.10:8080        (LAN testing only; apps refuse plain http unless "allow insecure http" is on)
# If empty, the owner can save it in the admin panel, else it is taken from the request's Host header.
WORKCHAT_PUBLIC_URL=http://localhost:8080
# Host port that publishes the server (the container always listens on 8080).
WORKCHAT_PORT=8080
# Host address the port is bound to. 0.0.0.0 = reachable from the network; 127.0.0.1 = only this machine
# (use that when your tunnel or proxy runs on the same host).
WORKCHAT_BIND_ADDR=0.0.0.0

# --- Server -------------------------------------------------------------------------------------------------------
# Name shown in the apps.
WORKCHAT_NAME=WorkChat
# First-run convenience: creates this owner account if no users exist (user:password). Leave empty to create the owner
# in the setup wizard at /admin instead.
WORKCHAT_BOOTSTRAP_ADMIN=
# Largest single attachment, in MB.
WORKCHAT_MAX_UPLOAD_MB=100
# Passphrase for the encrypted server backups. Empty = one is generated on first start into /data/backup.key (keep a copy
# of it somewhere else; it is never inside a backup).
WORKCHAT_BACKUP_PASSPHRASE=
# Log level: error, warn, info, debug, trace (or a filter such as info,tower_http=warn).
WORKCHAT_LOG_LEVEL=info,tower_http=warn

# --- Push notifications (optional) --------------------------------------------------------------------------------
# Base URL of YOUR OWN ntfy server, which runs as a separate container. Empty = no ntfy push. Examples:
#   https://ntfy.example.com                      (public address phones use)
#   http://host.docker.internal:2586              (ntfy published on this host; the compose file maps that name)
#   http://ntfy:80                                (ntfy on a shared Docker network, see the networks block in docker-compose.yml)
WORKCHAT_NTFY_URL=

# --- Image and data -----------------------------------------------------------------------------------------------
# Server image. Empty = the version this docker-compose.yml was released with (pinned). To follow the newest release:
#   WORKCHAT_IMAGE=ghcr.io/uri-travoski/workchat-claude-server:latest
# To move to a specific release: WORKCHAT_IMAGE=ghcr.io/uri-travoski/workchat-claude-server:1.1.0
# Then update with:  docker compose pull && docker compose up -d
WORKCHAT_IMAGE=
# Name of the Docker volume that holds /data (database, settings, backups). Empty = workchat-data.
# To keep using an existing Docker volume, put its name here (see docs/UPGRADING.md).
WORKCHAT_DATA_VOLUME=workchat-data

# --- Attachment storage -------------------------------------------------------------------------------------------
# Nothing to set here and no object-store container is shipped. On first setup open /admin > Storage and choose
# Amazon S3, Cloudflare R2, Backblaze B2 (any S3-compatible endpoint), Google Drive or local disk, then press Test.
#   Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region auto, an R2 API token's access key and secret.
#   Backblaze B2:  endpoint https://s3.<region>.backblazeb2.com (for example s3.us-west-004), region = that <region>, an application key.
