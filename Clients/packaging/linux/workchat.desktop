[Desktop Entry]
Type=Application
Name={{name}}
GenericName=Team chat
Comment=Direct messages, channels and threads for your own WorkChat server
Exec={{exec}} %U
Icon={{icon}}
Terminal=false
Categories=Network;Chat;InstantMessaging;
Keywords=chat;messenger;team;work;
MimeType=x-scheme-handler/workchat;
StartupWMClass=workchat
