{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WorkChat",
  "version": "1.6.0",
  "identifier": "app.workchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "WorkChat",
        "width": 1120,
        "height": 760,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: wcmedia: http://wcmedia.localhost; media-src 'self' blob: wcmedia: http://wcmedia.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "WorkChat",
    "copyright": "Copyright (c) 2026 WorkChat contributors",
    "category": "SocialNetworking",
    "shortDescription": "WorkChat team chat",
    "longDescription": "WorkChat: direct messages, channels, threads, voice messages and file sharing for your own WorkChat server.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/uri-travoski/workchat-claude"
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": [
            "workchat"
          ],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": [
          "workchat"
        ]
      }
    }
  }
}