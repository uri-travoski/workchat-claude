{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "section": "net",
        "priority": "optional",
        "depends": [
          "libasound2t64 | libasound2",
          "gstreamer1.0-plugins-good"
        ],
        "recommends": [
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "desktopTemplate": "../packaging/linux/workchat.desktop"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "alsa-lib"
        ],
        "recommends": [
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free"
        ],
        "desktopTemplate": "../packaging/linux/workchat.desktop"
      }
    }
  }
}
